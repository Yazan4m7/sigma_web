        function openModal(id, recheckCheckBoxes = false, caseId = 0) {
            console.log("modal opened id : " + id);
            if (recheckCheckBoxes)
            {

                let idFormatted = formatId(id);

                // Uncheck all checkboxes in the corresponding group.
                $('input[name="CheckBoxes' + idFormatted + '[]"]').prop('checked', false);

                // Check the checkbox with the value matching caseId.
                $('input[name="CheckBoxes' + idFormatted + '[]"][value="' + caseId + '"]').prop('checked', true);
            }

            console.log('Modal opened');
            console.log('ID :' + id);
            document.getElementById(id).style.display = 'flex';
            // $('#' + id).css('display', 'flex');
            $('#' + id).on('shown.bs.modal', '#' + id, function () {
                $(this).css({
                    'display': 'flex',      // Override 'display' style
                    'padding-right': '0'    // Override 'padding-right'
                });
            });
        }

        function closeModal(id, type) {
            console.log("closing modal " + id);
            try {
                document.getElementById(id).style.display = 'none';

            } catch (e) {
                c
                document.querySelectorAll('div[role="dialog"]').forEach(el => {
                    el.style.display = 'none';
                });

                console.log("modal not found closing all by role.. id : " + id + " exception : " + e);


            }

                    // not escaped
            resetAllBBWaitingDialogs(type);
        }

        function formatId(id) {
            // Check if id (in lowercase) starts with "3d"
            if (id.toLowerCase().startsWith("3d")) {
                // Preserve "3D" then capitalize the first character of the rest of the string.
                return "3D" + id.slice(2).charAt(0).toUpperCase() + id.slice(3);
            } else {
                // Default: Capitalize the first character.
                return id.charAt(0).toUpperCase() + id.slice(1);
            }
        }
